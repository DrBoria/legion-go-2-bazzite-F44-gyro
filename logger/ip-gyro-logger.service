[Unit]
# Passive diagnostic logger for the Legion Go 2 gyro patch.
#
# WHY: in gaming mode the virtual Steam Deck controller sometimes only maps A/B
# (no joysticks, no gyro). This unit runs a session-independent, timestamped
# logger that records device snapshots, udev add/remove events, IIO gyro/accel
# data, evdev key/axis events and session (gamescope/desktop) transitions, so we
# can tell whether physical input flows AND whether InputPlumber writes into the
# virtual deck device. It runs even when there is no terminal (gaming mode).
#
# Runs as root so /dev/input/* and /sys/bus/iio are readable. Output is mirrored
# to stdout, so it is also visible via: journalctl -u ip-gyro-logger
# Log file: /var/log/ip-gyro-logger.log
Description=IP Gyro diagnostic logger (Legion Go 2 gyro patch)
# Only order AFTER inputplumber — deliberately NOT Requires/After-strict so the
# logger still runs even if inputplumber is down (that is exactly what we want
# to diagnose).
After=inputplumber.service

[Service]
Type=simple
# Root so /dev/input/* and /sys/bus/iio are readable on every device.
User=root
ExecStart=/usr/bin/python3 /opt/ip-gyro-logger/ip-gyro-logger.py --log /var/log/ip-gyro-logger.log
# The logger itself is robust (global try/except, per-device isolation), but if
# it ever dies systemd brings it straight back so no evidence is lost.
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
