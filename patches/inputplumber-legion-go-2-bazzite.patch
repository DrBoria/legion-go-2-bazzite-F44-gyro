diff --git a/src/drivers/legion_state.rs b/src/drivers/legion_state.rs
new file mode 100644
index 0000000..867c2ca
--- /dev/null
+++ b/src/drivers/legion_state.rs
@@ -0,0 +1,47 @@
+//! Shared attach/detach state for Legion Go 2 controllers.
+//!
+//! The lego driver publishes the current docked/detached state here (derived
+//! from XInput report bytes 12-13, `l_con_state`/`r_con_state`). Other drivers
+//! in the same process (e.g. iio_imu) read it to decide which gyro source is
+//! active — WITHOUT any blocking USB/sysfs reads that could wedge the hub.
+
+use std::sync::atomic::{AtomicBool, AtomicU8, Ordering};
+
+/// Default assumption: controllers are DOCKED (attached). This matches the most
+/// common boot scenario (console in dock with ESO running). If the user boots
+/// detached, the first XInput report (~10 ms) will correct this.
+static ATTACHED: AtomicBool = AtomicBool::new(true);
+
+/// 0 = state has never been published yet; 1+ = at least one publish happened.
+static STATE_SET: AtomicU8 = AtomicU8::new(0);
+
+/// Publish the current attach state. Called by the lego driver whenever it sees
+/// a change in `l_con_state` (or on its very first report).
+pub fn set_attached(attached: bool) {
+    let _ = ATTACHED.swap(attached, Ordering::Relaxed);
+    STATE_SET.store(1, Ordering::Release);
+    // The atomics above remain the single source of truth for the
+    // gyro-source arbiter (iio_imu reads them via is_attached() /
+    // is_attached_or_default()). There is no orchestrator event bus to
+    // notify in the single-path build.
+}
+
+/// Returns the published attach state.
+/// - `None`: no XInput report has been received yet (driver just started).
+/// - `Some(true)`: controllers are docked/attached.
+/// - `Some(false)`: controllers are detached/wireless.
+pub fn is_attached() -> Option<bool> {
+    if STATE_SET.load(Ordering::Acquire) == 0 {
+        return None;
+    }
+    Some(ATTACHED.load(Ordering::Relaxed))
+}
+
+/// Convenience: returns the attach state, defaulting to `true` (docked) if no
+/// report has been received yet. Useful for initial filter setup.
+pub fn is_attached_or_default() -> bool {
+    match is_attached() {
+        Some(v) => v,
+        None => true,
+    }
+}
