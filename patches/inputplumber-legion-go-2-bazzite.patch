diff --git a/src/drivers/gyro_center.rs b/src/drivers/gyro_center.rs
new file mode 100644
index 0000000..ec194be
--- /dev/null
+++ b/src/drivers/gyro_center.rs
@@ -0,0 +1,282 @@
+//! Gyro-center source proxy/arbiter — fix (b), see `docs/plan-fix-b-gyro-proxy.md`.
+//!
+//! The "center" body IMU of the Legion Go 2 is reachable through TWO channels:
+//!   1. The lego XInput attached slot (`right_gyro_*`, report bytes 54-59) —
+//!      the PREFERRED source (round 5e ground truth; alive on our machine).
+//!   2. The IIO driver (`gyro_3d` gyro + `accel_3d` accel) — the fallback.
+//!
+//! ROUND 6 fixed the "4 из 70" bug (two conflicting `Gyroscope(Center)` streams
+//! merged by the composite) by ALWAYS filtering the IIO center. This proxy makes
+//! that choice DYNAMIC ("1 channel at a time"): as long as the active source
+//! shows gravity in its accelerometer it stays; if it goes dead (no gravity for
+//! `FALLBACK_MS`) and the OTHER source is alive, the arbiter switches. Exactly
+//! one channel therefore emits `Accelerometer(Center)`/`Gyroscope(Center)` at
+//! any moment.
+//!
+//! Design mirrors [`crate::drivers::legion_state`]: shared atomics only — no
+//! blocking sysfs/USB reads, no USB protocol. Health is fed in by the drivers
+//! themselves (`report_xinput_accel` from the lego driver on every XInput frame;
+//! `report_iio_accel` from the IIO driver's accelerometer poll), and
+//! [`evaluate`] runs on the IIO poll thread(s). All source transitions go
+//! through a single CAS winner so concurrent poll threads can never double-log
+//! or double-switch.
+//!
+//! Env (all optional; defaults == safe V9 behaviour):
+//!   `IP_GYRO_FORCE_IIO=1`          start the center on IIO once (validation)
+//!   `IP_GYRO_FALLBACK_MS`          dead threshold, default 2000 ms
+//!   `IP_GYRO_FALLBACK_XACCEL_LSB`  XInput "gravity present" threshold, 500 LSB
+//!   `IP_GYRO_FALLBACK_IACCEL_MS2`  IIO "gravity present" threshold, 3.0 m/s²
+
+use std::sync::atomic::{AtomicBool, AtomicI32, AtomicI64, AtomicU64, AtomicU8, Ordering};
+use std::sync::OnceLock;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+/// Active center-gyro source values for [`ACTIVE`].
+const SOURCE_XINPUT: u8 = 0; // lego XInput attached slot (round-6 / V9 default)
+const SOURCE_IIO: u8 = 1; // iio_imu accel_3d + gyro_3d
+
+/// Default source = XInput (exactly what ROUND 6 shipped). With the override
+/// OFF and XInput alive, behaviour stays 1:1 with V9 — no regression.
+static ACTIVE: AtomicU8 = AtomicU8::new(SOURCE_XINPUT);
+
+/// Once the arbiter has made ANY real transition (force apply or liveness
+/// fallback) the `IP_GYRO_FORCE_IIO` override is consumed, so it can never
+/// re-arm and re-flap the source every poll cycle.
+static FORCE_CONSUMED: AtomicBool = AtomicBool::new(false);
+
+/// Epoch-ms of the last XInput accel report whose magnitude reached the "gravity
+/// present" threshold. 0 = never alive.
+static XINPUT_LAST_ALIVE_MS: AtomicI64 = AtomicI64::new(0);
+
+/// Epoch-ms of the last IIO accel report whose magnitude reached the "gravity
+/// present" threshold. 0 = never alive.
+static IIO_LAST_ALIVE_MS: AtomicI64 = AtomicI64::new(0);
+
+/// Epoch-ms of the FIRST XInput report ever (any magnitude). Boot guard: the
+/// arbiter must never declare XInput dead before it has reported once, so a
+/// healthy boot cannot be wrongfully fallen back during its first few ms.
+static XINPUT_SEEN_AT_MS: AtomicI64 = AtomicI64::new(0);
+
+/// Latest XInput accel magnitude (LSB) — only used for the `[gyro-center]` logs.
+static XINPUT_MAG_LSB: AtomicI32 = AtomicI32::new(0);
+
+/// Latest IIO accel magnitude (m/s²) stored as f64 bits — only for the logs.
+static IIO_MAG_MS2_BITS: AtomicU64 = AtomicU64::new(0.0_f64.to_bits());
+
+/// Lazily parse an env var once. Each macro expansion owns its own `OnceLock`,
+/// so the parse runs at most once per process.
+macro_rules! env_var_once {
+    ($name:literal, $ty:ty, $default:expr) => {{
+        static V: std::sync::OnceLock<$ty> = std::sync::OnceLock::new();
+        *V.get_or_init(|| {
+            std::env::var($name)
+                .ok()
+                .and_then(|s| s.parse::<$ty>().ok())
+                .unwrap_or($default)
+        })
+    }};
+}
+
+/// `IP_GYRO_FORCE_IIO=1` -> start the center on IIO once (validation scenario b).
+fn force_iio() -> bool {
+    static V: OnceLock<bool> = OnceLock::new();
+    *V.get_or_init(|| {
+        std::env::var("IP_GYRO_FORCE_IIO")
+            .map(|v| v == "1")
+            .unwrap_or(false)
+    })
+}
+
+/// A source is declared dead after `FALLBACK_MS` without gravity.
+fn fallback_ms() -> i64 {
+    env_var_once!("IP_GYRO_FALLBACK_MS", i64, 2000)
+}
+
+/// XInput accel magnitude >= this (LSB) counts as gravity present (alive).
+fn xinput_alive_lsb() -> i32 {
+    env_var_once!("IP_GYRO_FALLBACK_XACCEL_LSB", i32, 500)
+}
+
+/// IIO accel magnitude >= this (m/s²) counts as gravity present (alive).
+fn iio_alive_ms2() -> f64 {
+    env_var_once!("IP_GYRO_FALLBACK_IACCEL_MS2", f64, 3.0)
+}
+
+/// Current epoch time in ms.
+fn now_ms() -> i64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_millis() as i64)
+        .unwrap_or(0)
+}
+
+/// Magnitude of an i16 accel vector in LSB (squared in i64 to avoid overflow).
+fn mag_lsb(x: i16, y: i16, z: i16) -> i32 {
+    let x = x as i64;
+    let y = y as i64;
+    let z = z as i64;
+    ((x * x + y * y + z * z) as f64).sqrt() as i32
+}
+
+/// Magnitude of an f64 accel vector in m/s².
+fn mag_ms2(roll: f64, pitch: f64, yaw: f64) -> f64 {
+    (roll * roll + pitch * pitch + yaw * yaw).sqrt()
+}
+
+/// Reference time XInput uses to measure how long it has been without gravity:
+/// the last gravity-bearing report if any, else the first report ever (boot
+/// guard). 0 = XInput has not reported at all yet.
+fn xinput_life_ms() -> i64 {
+    let alive = XINPUT_LAST_ALIVE_MS.load(Ordering::Relaxed);
+    if alive != 0 {
+        return alive;
+    }
+    XINPUT_SEEN_AT_MS.load(Ordering::Relaxed)
+}
+
+/// Feed the XInput accel (gravity) from the lego driver — called on EVERY
+/// XInput frame, attached or detached, filtered or not (filtering only gates
+/// emission).
+pub fn report_xinput_accel(x: i16, y: i16, z: i16) {
+    let now = now_ms();
+    // Boot guard: record the first report so the arbiter never declares XInput
+    // dead before it has ever spoken (only the first caller wins the CAS).
+    if XINPUT_SEEN_AT_MS.load(Ordering::Relaxed) == 0 {
+        let _ =
+            XINPUT_SEEN_AT_MS.compare_exchange(0, now, Ordering::Relaxed, Ordering::Relaxed);
+    }
+    let mag = mag_lsb(x, y, z);
+    XINPUT_MAG_LSB.store(mag, Ordering::Relaxed);
+    if mag >= xinput_alive_lsb() {
+        XINPUT_LAST_ALIVE_MS.store(now, Ordering::Relaxed);
+    }
+}
+
+/// Feed the IIO accel (gravity) from the iio_imu driver's accelerometer poll
+/// (only the accel-bearing `accel_3d` device reports non-empty here).
+pub fn report_iio_accel(roll: f64, pitch: f64, yaw: f64) {
+    let now = now_ms();
+    let mag = mag_ms2(roll, pitch, yaw);
+    IIO_MAG_MS2_BITS.store(mag.to_bits(), Ordering::Relaxed);
+    if mag >= iio_alive_ms2() {
+        IIO_LAST_ALIVE_MS.store(now, Ordering::Relaxed);
+    }
+}
+
+/// Should the center IMU come from the IIO driver right now? Both the iio_imu
+/// and the lego drivers call this to build their event filters, so exactly ONE
+/// channel emits `Accelerometer(Center)`/`Gyroscope(Center)` at a time.
+pub fn use_iio_for_center() -> bool {
+    // The IIO center is only meaningful while the console is docked/attached:
+    // when detached the XInput "center" slot is the handle itself and the lego
+    // driver must keep emitting it (round 5e). `FORCE_IIO` overrides the
+    // arbiter's START state only: it is gated by `!FORCE_CONSUMED` so that once
+    // the arbiter has made a real transition (force apply or liveness fallback)
+    // the ACTIVE source alone rules. Without this gate the env override would
+    // pin `force_iio()` true for the whole process and the fallback's source
+    // switch would never reach the event filters (validation bug, 2026-09-03).
+    crate::drivers::legion_state::is_attached_or_default()
+        && (active_is_iio() || (force_iio() && !FORCE_CONSUMED.load(Ordering::Relaxed)))
+}
+
+/// Human-readable name of the EFFECTIVE center source (for debug/log markers).
+pub fn active_source_str() -> &'static str {
+    if active_is_iio() || (force_iio() && !FORCE_CONSUMED.load(Ordering::Relaxed)) {
+        "IIO"
+    } else {
+        "XInput"
+    }
+}
+
+fn active_is_iio() -> bool {
+    ACTIVE.load(Ordering::Relaxed) == SOURCE_IIO
+}
+
+/// Single-winner transition: only the thread that wins the CAS proceeds (and
+/// only the winner logs). Marks the force override consumed so a liveness
+/// fallback can never be re-flapped back by the env override.
+fn try_switch(from: u8, to: u8) -> bool {
+    if ACTIVE
+        .compare_exchange(from, to, Ordering::AcqRel, Ordering::Relaxed)
+        .is_err()
+    {
+        return false; // another poll thread already transitioned
+    }
+    FORCE_CONSUMED.store(true, Ordering::Relaxed);
+    true
+}
+
+/// Elapsed ms a source has been without gravity, for the log markers (a
+/// never-alive source reports the full fallback window).
+fn dead_since_ms(now: i64, last_alive: i64, fallback: i64) -> i64 {
+    if last_alive == 0 {
+        fallback
+    } else {
+        now.saturating_sub(last_alive).max(0)
+    }
+}
+
+/// Run the center-source arbitration. Called on every IIO poll (both the
+/// `accel_3d` and `gyro_3d` driver instances share these statics — hence the
+/// CAS-everywhere design).
+pub fn evaluate() {
+    let now = now_ms();
+    let attached = crate::drivers::legion_state::is_attached_or_default();
+    let fb = fallback_ms();
+
+    // Detached: ROUND 6 shipped XInput as the source in BOTH states, so if the
+    // arbiter had moved us to IIO while attached, force the V9 default back.
+    if !attached {
+        if try_switch(SOURCE_IIO, SOURCE_XINPUT) {
+            log::info!("[gyro-center] detached: active source = XInput (round-6 V9 default)");
+        }
+        return;
+    }
+
+    // `IP_GYRO_FORCE_IIO=1` (validation scenario b): start the center on IIO
+    // once. Normal liveness arbitration then takes over and falls back to
+    // XInput if the IIO is dead (our machine) or stays on IIO if it is alive.
+    // `FORCE_CONSUMED` prevents the override from re-arming after a fallback.
+    if force_iio() && !FORCE_CONSUMED.load(Ordering::Relaxed) {
+        if try_switch(SOURCE_XINPUT, SOURCE_IIO) {
+            log::info!(
+                "[gyro-center] override IP_GYRO_FORCE_IIO=1: center starts on IIO (attached)"
+            );
+        }
+        return;
+    }
+
+    if active_is_iio() {
+        // IIO-active: never-alive counts as dead, so a forced/dead IIO falls
+        // back and a live IIO that later dies does too. Requires XInput alive.
+        let i_last = IIO_LAST_ALIVE_MS.load(Ordering::Relaxed);
+        let i_dead = i_last == 0 || now.saturating_sub(i_last) >= fb;
+        let x_life = xinput_life_ms();
+        let x_alive = x_life != 0 && now.saturating_sub(x_life) < fb;
+        if i_dead && x_alive && try_switch(SOURCE_IIO, SOURCE_XINPUT) {
+            log::info!(
+                "[gyro-center] IIO center IMU dead: no accel-gravity for {} ms (iio_accel_mag={:.2} m/s2); XInput accel_mag={} LSB alive -> switch center gyro source IIO->XInput",
+                dead_since_ms(now, i_last, fb),
+                f64::from_bits(IIO_MAG_MS2_BITS.load(Ordering::Relaxed)),
+                XINPUT_MAG_LSB.load(Ordering::Relaxed)
+            );
+        }
+    } else {
+        // XInput-active: conservative — never declare XInput dead before its
+        // first report (boot guard) and only after FALLBACK_MS without gravity.
+        // Requires the IIO to have shown gravity recently (it must be alive).
+        let x_life = xinput_life_ms();
+        let x_dead = x_life != 0 && now.saturating_sub(x_life) >= fb;
+        let i_last = IIO_LAST_ALIVE_MS.load(Ordering::Relaxed);
+        let i_alive = i_last != 0 && now.saturating_sub(i_last) < fb;
+        if x_dead && i_alive && try_switch(SOURCE_XINPUT, SOURCE_IIO) {
+            log::info!(
+                "[gyro-center] XInput center IMU dead: no accel-gravity for {} ms (xaccel_mag={} LSB); IIO accel_mag={:.2} m/s2 alive -> switch center gyro source XInput->IIO",
+                dead_since_ms(now, x_life, fb),
+                XINPUT_MAG_LSB.load(Ordering::Relaxed),
+                f64::from_bits(IIO_MAG_MS2_BITS.load(Ordering::Relaxed))
+            );
+        }
+    }
+}
+
