+# RESUME FIX (Legion Go 2 / Bazzite): HookWake re-creates the virtual Steam Deck
+# controller (28de:1205), but udev is not re-triggered, so Steam (running through
+# suspend) never re-detects it. Re-scan input/hidraw/iio nodes after wake so the
+# controller (joysticks + touchpads + gyro) returns to Steam. Suspend side (above)
+# is intentionally left untouched.
+ExecStop=/bin/bash -c 'busctl call org.shadowblip.InputPlumber /org/shadowblip/InputPlumber/Manager org.shadowblip.InputManager HookWake; sleep 2; udevadm trigger --subsystem-match=input --subsystem-match=hidraw --subsystem-match=iio'
 
 [Install]
 WantedBy=sleep.target
